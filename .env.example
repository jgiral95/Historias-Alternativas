# Copie este archivo como .env y complete los valores. Nunca suba .env a GitHub.

POSTGRES_DB=historias
POSTGRES_USER=historias
POSTGRES_PASSWORD=cambie-esta-contrasena

# Genere con: openssl rand -hex 32
SESSION_SECRET=

# Clave de cifrado del contenido clínico. Genere con:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# GUARDE UNA COPIA FUERA DEL SERVIDOR: sin esta clave los datos no se pueden recuperar.
# Para rotarla, ponga la clave nueva primero y la anterior después, separadas por coma.
DATA_KEY=

# Minutos sin actividad tras los cuales la sesión se cierra sola (mínimo 5)
IDLE_MINUTES=30

# Verificación en dos pasos: días sin usar un dispositivo recordado tras los cuales se vuelve a pedir el código.
# 0 desactiva «Recordar este dispositivo» (el código se pide en cada ingreso).
TRUSTED_DEVICE_DAYS=30

# Conexión directa con Google Calendar (opcional; vea «Google Calendar» en el README).
# PUBLIC_URL es la dirección pública de la app, sin barra final, por ejemplo https://historias.midominio.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=

# Correo para enviar las encuestas de satisfacción (opcional; vea «Encuestas de satisfacción» en el README).
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=su correo y SMTP_PASSWORD una «contraseña de aplicación».
# Requiere también PUBLIC_URL (arriba), para armar el enlace de la encuesta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Versión beta: botón «Comentarios» abajo a la derecha.
# Póngalo en 0 antes de atender clientes reales: oculta el botón .
BETA_COMENTARIOS=1

# Puerto del servidor en el host (el 8000 lo usa Portainer y el 8085 Gatelier)
APP_PORT=8086
